---
import { footerMenu, socialMenu, docsMenu } from '@data/menu';
import Logo from '@components/Logo.astro';
import MyLogo from './myLogo.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/config';

interface ButtonProps {
  text: string;
  link: string;
  target?: string;
}

interface Props {
  footerCta?: {
    title: string;
    description: string;
    hideCta: boolean;
    button: ButtonProps;
  };
}

const { footerCta } = Astro.props;

const defaultCta = {
  title: "Ready Work With Me?",
  description: "I’m always open to new opportunities and creative collaborations. Let’s bring your ideas to life with impactful design.",
  hideCta: false,
  button: {
    text: "Contact Me",
    link: "/contact",
    target: "_self"
  }
};

const cta = footerCta || defaultCta;
const currentYear = new Date().getFullYear();
---

<footer class={`bg-background-dark text-body-base pb-small ${cta.hideCta ? 'pt-large' : 'pt-base'}`}>
  <div class="site-container mx-auto px-4">
    {!cta.hideCta && (
      <div class="text-center border-b border-background-light mb-12 pb-base">
        <h2 class="text-body-base font-bold max-w-2xl mx-auto mb-4" data-aos="fade-up">{cta.title}</h2>
        <p class="text-body-light mb-6 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
          {cta.description}
        </p>
        <Button 
          href={cta.button.link} 
          variant="primary"
          size="lg"
          data-aos="fade-up"
          data-aos-delay="200"
          {...(cta.button.target && { target: cta.button.target })}
        >
          {cta.button.text}
        </Button>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-8 lg:gap-0 pb-8 border-b border-background-light">
      <div class="relative items-start">
        <div class="relative">
          <MyLogo variant='footer'/>
        </div>
        
        <p class="mt-4 text-body-light max-w-lg text-small">
          <span 
            class="block">Habibmuhd | 
            <span id="role" class="transition-opacity duration-500">Graphic Design</span>
          </span>
          <span class="block">Open for collaborations and new opportunities.</span>
        </p>
        
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-8 lg:gap-0 md:justify-items-start">
        <div class="relative">
          <h3 class="text-lg font-semibold mb-4">Pages</h3>
          <nav>
            <ul class="space-y-2">
              {footerMenu.map(item => (
                <li><a href={item.link} class="text-small text-body-dark hover:text-white transition-colors">{item.name}</a></li>
              ))}
            </ul>
          </nav>
        </div>

        <div class="relative">
          <h3 class="text-lg font-semibold mb-4">Documents</h3>
          <nav>
            <ul class="space-y-2">
              {docsMenu.map(item => (
                <li><a href={item.link} class="text-small text-body-dark hover:text-white transition-colors">{item.name}</a></li>
              ))}
            </ul>
          </nav>
        </div>

        <div class="relative">
          <h3 class="text-lg font-semibold mb-4">Socials</h3>
          <nav>
            <ul class="space-y-2">
              {socialMenu.map(item => (
                <li><a href={item.link} class="text-small text-body-dark hover:text-white transition-colors" target='_blank'>{item.name}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <div class="text-body-dark text-xsmall">
        © {currentYear} {siteConfig.companyName}. All rights reserved.
      </div>
      
      <!-- <nav class="mt-4 md:mt-0">
        <ul class="flex flex-wrap gap-6">
          {legalMenu.map(item => (
            <li>
              <a 
                href={item.link} 
                class="text-xsmall text-body-dark hover:text-white transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav> -->
    </div>
  </div>
</footer>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const roles = ["Graphic Design", "Digital Imaging", "UI/UX Design", "Motion Graphic", "Animation", "Video Editing"];
  const roleElement = document.getElementById("role");
  if (!roleElement) { 
    console.error("Element with id='role' not found"); 
    return; 
  }

  let index = 0;
  const FADE_MS = 500;    
  const INTERVAL_MS = 3000; 

  setInterval(() => {
    roleElement.classList.add("opacity-0");

    
    setTimeout(() => {
      index = (index + 1) % roles.length;
      roleElement.textContent = roles[index];
      roleElement.classList.remove("opacity-0");
    }, FADE_MS);
  }, INTERVAL_MS);
});
</script>
