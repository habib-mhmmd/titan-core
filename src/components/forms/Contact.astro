---
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/form/Input.astro";
import Textarea from "@components/ui/form/Textarea.astro";
import { Send } from 'lucide-astro';

const formBackground = 'dark';
---

<form id="contact-form" class="space-y-6 bg-background-light p-6 rounded-[var(--border-radius-xlarge)]">
    <Textarea
        label="Message"
        id="message"
        name="message"
        required
        background={formBackground}
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <Input
            label="Name"
            id="name"
            name="name"
            required
            background={formBackground}
        />
        <Input
            label="Email"
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
            background={formBackground}
        />
    </div>
    <!-- 🧩 Capybara Captcha -->
    <!-- <div id="captcha-container" class="mt-4 text-sm text-gray-300"></div>
    <input type="hidden" id="captcha_token" name="captcha_token" /> -->

    <div class="border p-4 rounded-md bg-gray-50">
      <p class="mb-2 font-medium">Verification</p>
      <button
        id="captcha-btn"
        type="button"
        class="px-4 py-2 bg-blue-600 text-white rounded-md"
      >
        Verify CAPTCHA
      </button>
      <p id="captcha-status" class="text-sm mt-2 text-gray-600">
        Not verified yet.
      </p>
    </div>

    <div class="grid grid-cols-1 mt-6 justify-items-end">
        <Button variant="secondary" type="submit" id="contact-submit">
            Send
            <Send class="w-4 h-4 ml-1" />
        </Button>
    </div>

</form>

<script>
document.addEventListener("DOMContentLoaded", async () => {
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const submitBtn = document.querySelector<HTMLButtonElement>("#contact-submit");
  const captchaContainer = document.querySelector<HTMLElement>("#captcha-container");

  if (!form || !captchaContainer) return;

  async function loadCaptcha() {
    try {
      // 🔹 Ambil challenge captcha dari server
      const captchaRes = await fetch("/api/captcha");
      const captchaData = await captchaRes.json();

      captchaContainer!.innerHTML = captchaData.html;
      const tokenInput = document.querySelector<HTMLInputElement>("#captcha_token");
      if (tokenInput) tokenInput.value = captchaData.token;
    } catch (err) {
      captchaContainer!.innerHTML = "<p class='text-red-500'>Gagal memuat captcha.</p>";
    }
  }

  // 🔹 Panggil pertama kali
  await loadCaptcha();

  // 🔹 Listener submit form
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (submitBtn) submitBtn.disabled = true;

    // Use HTMLFormElement.checkValidity()
    if (!form.checkValidity()) {
      if (submitBtn) submitBtn.disabled = false;
      return;
    }

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await res.json();
      alert(result.message);
      if (result.success) {
        form.reset();          // Bersihkan isi form
        await loadCaptcha();   // Muat ulang captcha baru
      }
    } catch (err) {
      alert("Terjadi kesalahan saat mengirim pesan.");
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
});
</script>

